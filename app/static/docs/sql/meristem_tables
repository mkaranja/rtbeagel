-- Table: public.tbl_meristem_culture

-- DROP TABLE IF EXISTS public.tbl_meristem_culture;

CREATE TABLE IF NOT EXISTS public.tbl_meristem_culture
(
    sample_code character varying(50) COLLATE pg_catalog."default" NOT NULL,
    meristem_culture_date date NOT NULL,
    number_of_meristems integer NOT NULL,
    done_by character varying(50) COLLATE pg_catalog."default" NOT NULL,
    source_code character varying(50) COLLATE pg_catalog."default",
    updated_on date,
    updated_by character varying COLLATE pg_catalog."default",
    reviewed_on date,
    reviewed_by character varying COLLATE pg_catalog."default",
    review character varying COLLATE pg_catalog."default",
    review_notes character varying COLLATE pg_catalog."default",
    status character varying COLLATE pg_catalog."default",
    CONSTRAINT tbl_meristem_culture_pkey PRIMARY KEY (sample_code)
)

-- Table: public.tbl_meristem_culture_review

-- DROP TABLE IF EXISTS public.tbl_meristem_culture_review;

CREATE TABLE IF NOT EXISTS public.tbl_meristem_culture_review
(
    sample_code character varying(20) COLLATE pg_catalog."default" NOT NULL,
    review character varying(20) COLLATE pg_catalog."default" NOT NULL,
    review_comment character varying(200) COLLATE pg_catalog."default",
    review_date date NOT NULL,
    reviewed_by character varying(20) COLLATE pg_catalog."default" NOT NULL,
    CONSTRAINT tbl_meristem_culture_review_pkey PRIMARY KEY (sample_code)
)

-- Table: public.tbl_meristem_log

-- DROP TABLE IF EXISTS public.tbl_meristem_log;

CREATE TABLE IF NOT EXISTS public.tbl_meristem_log
(
    log_id integer NOT NULL DEFAULT nextval('tbl_meristem_log_log_id_seq'::regclass),
    sample_code character varying(50) COLLATE pg_catalog."default",
    change_date timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    change_type character varying(50) COLLATE pg_catalog."default",
    quantity_affected integer NOT NULL,
    remaining_total integer NOT NULL,
    recorded_by character varying(50) COLLATE pg_catalog."default",
    notes text COLLATE pg_catalog."default",
    CONSTRAINT tbl_meristem_log_pkey PRIMARY KEY (log_id),
    CONSTRAINT tbl_meristem_log_sample_code_fkey FOREIGN KEY (sample_code)
        REFERENCES public.tbl_meristem_culture (sample_code) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)

-- Table: public.tbl_meristem_logs

-- DROP TABLE IF EXISTS public.tbl_meristem_logs;

CREATE TABLE IF NOT EXISTS public.tbl_meristem_logs
(
    log_id integer NOT NULL DEFAULT nextval('tbl_meristem_logs_log_id_seq'::regclass),
    sample_code character varying(50) COLLATE pg_catalog."default",
    event_type character varying(50) COLLATE pg_catalog."default",
    count_change integer,
    recorded_at timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    recorded_by character varying(50) COLLATE pg_catalog."default",
    CONSTRAINT tbl_meristem_logs_pkey PRIMARY KEY (log_id),
    CONSTRAINT tbl_meristem_logs_sample_code_fkey FOREIGN KEY (sample_code)
        REFERENCES public.tbl_meristem_culture (sample_code) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)


